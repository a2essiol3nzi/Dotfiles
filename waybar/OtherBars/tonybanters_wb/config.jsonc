// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  // "height": 30,
  "spacing": 4,
  // Choose the order of the modules
  "modules-left": [
    "sway/workspaces",
    "custom/sep",
    "sway/window",
    "custom/sep"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/sep",
    "battery",
    "custom/sep",
    "cpu",
    "custom/sep",
    "memory",
    "custom/sep",
    "pulseaudio",
    "custom/sep",
    "clock",
    "custom/sep",
    "tray"
  ],
  // Modules configuration
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}",
    "persistent-workspaces": {
      "󰣇": 9
    }
  },
  "sway/window": {
    "max-length": 40,
    "seperate-outputs": false
  },
  "tray": {
    "icon-size": 17,
    "spacing": 10
  },
  "clock": {
    "format-alt": "{:%d-%m-%Y}"
  },
  "cpu": {
    "interval": 5,
    "format": "CPU: {usage}%",
    "tooltip": true,
    "on-click": "kitty btop"
  },
  "memory": {
    "interval": 5,
    "format": "Mem: {used}GiB",
    "tooltip": true
  },
  "disk": {
    "interval": 60,
    "path": "/",
    "format": "Disk: {free}"
  },
  "battery": {
    "interval": 5,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "Bat {capacity}%",
    "format-charging": "{capacity}% ",
    "format-alt": "Bat: {capacity}% {icon},{time}",
    "format-time": "{H}:{M}",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ],
    "tooltip": true
  },
  "network": {
    "format": "Online",
    "format-disconnected": "Disconnected ⚠ "
  },
  "pulseaudio": {
    "format": "{icon}  {volume:2}%",
    "format-bluetooth": " {volume}%",
    "format-muted": "MUTE",
    "format-icons": {
      "headphones": "",
      "default": [
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "tooltip": true
  },
  "custom/sep": {
    "format": "|",
    "interval": 0
  }
}